# Server-only settings. Copy to backend/.env (git-ignored). Example values are placeholders.
DATABASE_URL="postgresql://shopsmart_user:CHANGE_ME@localhost:5432/shopsmart?schema=public"
PORT=3000
# 127.0.0.1 on EC2 so only Caddy (443) is public; 0.0.0.0 is fine for local development.
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Set to 1 behind exactly one reverse proxy (Caddy on EC2) so rate limits see real client IPs.
# TRUST_PROXY=1
# Forces the Secure cookie flag outside production (NODE_ENV=production already sets it).
# COOKIE_SECURE=true

# AI assistant (server only). The key never goes in frontend code or git.
# AI_PROVIDER=mock  -> labeled simulated provider, no key, no network call (used for the hosted classroom demo)
# AI_PROVIDER=off   -> rule-based answers only
# AI_PROVIDER=gemini with GEMINI_API_KEY -> live Google Gemini draft, verified against the catalog
AI_PROVIDER=mock
# MOCK_AI_FAILURE=timeout | rate-limit | bad-response | unknown-product  (every request), or add "#simulate-timeout" etc. to a question
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=12000
