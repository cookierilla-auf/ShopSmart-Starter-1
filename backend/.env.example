DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# AI assistant (server only). Put the real key in backend/.env, never in frontend code or git.
# AI_PROVIDER=off forces the rule-based answer; a small AI_TIMEOUT_MS simulates a provider timeout.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_MS=12000
